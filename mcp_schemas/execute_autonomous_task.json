{
  "name": "execute_autonomous_task",
  "description": "Autonomous In-Memory Vision Runner (AIM-VR 2.0). Executes a sequence of multi-step desktop actions in a fast closed loop locally. Each step resolves elements via UIA -> WinRT OCR -> SOM, performs the action, and verifies visual reaction in memory (<30ms) without multi-turn LLM round-trips.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "steps": {
        "description": "List of actions to execute sequentially in memory.",
        "items": {
          "properties": {
            "action": {
              "description": "Action type to perform.",
              "enum": [
                "click",
                "double_click",
                "right_click",
                "triple_click",
                "hover",
                "move",
                "type_text",
                "paste_text",
                "press_key",
                "hotkey",
                "wait",
                "focus_window",
                "close_window",
                "launch_app",
                "manage_window",
                "control_media",
                "invoke_element",
                "set_value"
              ],
              "type": "string"
            },
            "args": {
              "description": "Optional arguments for 'launch_app'.",
              "type": "string"
            },
            "bounds": {
              "description": "Bounds [x, y, w, h] for manage_window move_resize.",
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "command": {
              "description": "Command for control_media.",
              "type": "string"
            },
            "duration": {
              "description": "Hover duration in seconds.",
              "type": "number"
            },
            "force": {
              "description": "Optional force flag for 'close_window'.",
              "type": "boolean"
            },
            "key": {
              "description": "Key name for 'press_key'.",
              "type": "string"
            },
            "keys": {
              "description": "Key combo for 'hotkey' (e.g. ['ctrl', 'l']).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "mark_id": {
              "description": "Set-of-Marks integer badge ID to click.",
              "type": "integer"
            },
            "name": {
              "description": "Application name for 'launch_app' (e.g. 'chrome', 'notepad').",
              "type": "string"
            },
            "position": {
              "description": "Position for manage_window snap.",
              "type": "string"
            },
            "query": {
              "description": "Semantic name or text of UI element to click/move/hover to (e.g. 'Downloads', 'Save', 'File Explorer').",
              "type": "string"
            },
            "restore": {
              "description": "Whether to restore clipboard after paste_text.",
              "type": "boolean"
            },
            "seconds": {
              "description": "Seconds to wait for 'wait'.",
              "type": "number"
            },
            "state": {
              "description": "State for manage_window state.",
              "type": "string"
            },
            "steps": {
              "description": "Steps for volume adjustment in control_media.",
              "type": "integer"
            },
            "sub_action": {
              "description": "Sub-action for manage_window or control_media.",
              "type": "string"
            },
            "target": {
              "description": "Target window title substring to focus, close, or scope the action to.",
              "type": "string"
            },
            "text": {
              "description": "Text to type or paste.",
              "type": "string"
            },
            "x": {
              "description": "Optional explicit X coordinate.",
              "type": "number"
            },
            "y": {
              "description": "Optional explicit Y coordinate.",
              "type": "number"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "verify": {
        "default": true,
        "description": "Whether to run closed-loop visual servoing reaction verification after each action.",
        "type": "boolean"
      }
    },
    "required": [
      "steps"
    ],
    "type": "object"
  }
}