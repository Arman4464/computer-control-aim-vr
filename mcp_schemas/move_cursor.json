{
  "name": "move_cursor",
  "description": "Moves mouse cursor to specified coordinates.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "coords_mode": {
        "default": "pixel",
        "description": "Coordinate space.",
        "enum": [
          "pixel",
          "normalized_1000"
        ],
        "type": "string"
      },
      "x": {
        "description": "Target X coordinate.",
        "type": "number"
      },
      "y": {
        "description": "Target Y coordinate.",
        "type": "number"
      }
    },
    "required": [
      "x",
      "y"
    ],
    "type": "object"
  }
}